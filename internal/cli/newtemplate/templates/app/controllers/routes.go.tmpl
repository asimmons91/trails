package controllers

import (
	"io/fs"
	"time"

	"github.com/asimmons91/trails"
	"github.com/asimmons91/trails/cache"
	"github.com/asimmons91/trails/csrf"
	"github.com/asimmons91/trails/jobs"
	"github.com/asimmons91/trails/pack"
	"github.com/asimmons91/trails/secureheaders"
	"github.com/asimmons91/trails/session"
)

// jobsBackend is available here for controllers that need to enqueue
// background work — e.g. jobs.Enqueue(ctx, jobsBackend, &mailers.WelcomeEmail{...}).
//
// cacheStore and cacheTTL are available for controllers that need caching —
// e.g. cache.Fetch(ctx, cacheStore, key, cacheTTL, func() (...) { ... }), or
// httpcache.Middleware(cacheStore, httpcache.WithTTL(cacheTTL)) applied to a
// specific r.NewGroup of read-heavy, non-personalized routes. It is not
// applied globally here since caching is opt-in per route, not a blanket
// default.
func Routes(db *pack.DB, jobsBackend jobs.Backend, cacheStore cache.Store, cacheTTL time.Duration, secretKeyBase string, assetsFS, staticFS fs.FS) trails.RouteBuilder {
	return func(r *trails.Router) {
		r.Static("/assets/", assetsFS)
		r.Static("/static/", staticFS)

		// secureheaders sets HSTS/nosniff/frame-options/referrer-policy on
		// every response with framework defaults; it has no dependency on
		// session/csrf, so it's registered first. session must come before
		// csrf: csrf.Middleware reads the current session's token via
		// session.FromContext and panics if none is present on the
		// Context. All three apply to every route registered below
		// (Static above is unaffected — it bypasses middleware entirely).
		r.Use(secureheaders.Middleware(), session.Middleware(secretKeyBase), csrf.Middleware())

		// trustedproxy resolves the real client IP/scheme from
		// X-Forwarded-For/X-Forwarded-Proto, but only behind a reverse
		// proxy on a known network — there is no default trusted list.
		// It's independent of allowedhosts below (composable in either
		// order) and safe to leave unconfigured otherwise:
		//
		// r.Use(trustedproxy.Middleware(trustedproxy.WithTrustedProxies(trustedproxy.PrivateCIDRs...)))

		// allowedhosts is off by default (no allowed hosts configured) —
		// enable it once you know your app's real hostname(s) to
		// validate the Host header before any handler runs. If enabled,
		// register it outermost, ahead of the r.Use above, so a
		// disallowed Host is rejected before any other middleware does
		// work:
		//
		// r.Use(allowedhosts.Middleware(allowedhosts.WithAllowedHosts("example.com", ".example.com")))

		// CORS is off by default (no allowed origins configured) — most
		// server-rendered trails apps have no separate cross-origin
		// frontend to allow. If you're serving a separate SPA/mobile
		// client, scope cors.Middleware to that API's own group/prefix and
		// register a matching OPTIONS route so preflight requests reach
		// it — trails registers routes against Go's http.ServeMux with
		// per-method patterns, so an OPTIONS request against a path with
		// no OPTIONS route never reaches any middleware at all. See the
		// cors package doc comment for the full explanation, including why
		// an OPTIONS route must not be registered at the router root in an
		// app using Router.Static (as this one does, above):
		//
		// api := r.NewGroup("/api", cors.Middleware(cors.WithAllowedOrigins("https://app.example.com")))
		// api.HandleFunc(http.MethodOptions, "/{path...}", cors.PreflightHandler)

		examples := NewExamplesController(db)

		r.Get("/examples", examples.Index)
		r.Post("/examples", examples.Create)
	}
}
