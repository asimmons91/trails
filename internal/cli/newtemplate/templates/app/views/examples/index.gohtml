{{ define "content" }}
  <h1>Examples</h1>

  <form method="post" action="/examples">
    {{ csrfField }}
    <input type="text" name="title" placeholder="Title" required />
    <button type="submit">Create</button>
  </form>

  <ul>
    {{ range . }}
      <li>{{ .Title }}</li>
    {{ else }}
      <li>No examples yet.</li>
    {{ end }}
  </ul>
{{ end }}
