package app

import (
	"log/slog"
	"os"

	"github.com/asimmons91/trails"
	"github.com/asimmons91/trails/csrf"
	"github.com/asimmons91/trails/jobs"
	"github.com/asimmons91/trails/jobs/backend/async"

	"{{.ModulePath}}/app/cache"
	"{{.ModulePath}}/app/controllers"
	"{{.ModulePath}}/app/mailers"
	"{{.ModulePath}}/app/views"
	"{{.ModulePath}}/config"
	"{{.ModulePath}}/db"
	"{{.ModulePath}}/public"
)

func Boot() error {
	env := trails.Environment()

	cfg, err := trails.LoadConfig[config.Config](env, config.ConfigFS)
	if err != nil {
		return err
	}

	creds, err := trails.LoadCredentials[config.Credentials](env, config.ConfigFS)
	if err != nil {
		return err
	}

	pdb, err := db.ConnectWithConfig(cfg)
	if err != nil {
		return err
	}

	logger := slog.New(slog.NewTextHandler(os.Stdout, nil))

	mailRenderer, mailTransport, err := mailers.Configure(cfg, logger)
	if err != nil {
		return err
	}

	jobsReg := jobs.NewRegistry()
	mailers.Register(jobsReg, mailRenderer, mailTransport, cfg.Mailer.From)
	jobsBackend := async.New(jobsReg, 2)
	defer jobsBackend.Close()

	cacheStore, cacheTTL, err := appcache.Configure(cfg, pdb)
	if err != nil {
		return err
	}

	// The memory cache backend needs a background sweep loop to evict
	// expired entries; other backends (file, redis, ...) won't implement
	// trails.Runner and are simply skipped here.
	var runners []trails.Runner
	if runner, ok := any(cacheStore).(trails.Runner); ok {
		runners = append(runners, runner)
	}

	t, err := trails.New(trails.WithDefaultOptions(&trails.TrailOptions{
		Host:           cfg.Server.Host,
		Port:           cfg.Server.Port,
		LayoutName:     cfg.Views.LayoutName,
		Logger:         logger,
		RouteBuilder:   controllers.Routes(pdb, jobsBackend, cacheStore, cacheTTL, creds.SecretKeyBase, public.AssetsFS, public.StaticFS),
		ViewFS:         views.ViewsFS,
		ConfigFS:       config.ConfigFS,
		AssetsFS:       public.AssetsFS,
		Runners:        runners,
		FuncMap:        csrf.PlaceholderFuncMap,
		RequestFuncMap: csrf.RequestFuncMap,
{{if eq .AssetsStrategy "bundler"}}		AssetsStrategy: trails.AssetsStrategyBundler,
{{end}}	}))
	if err != nil {
		return err
	}

	return t.Run()
}
