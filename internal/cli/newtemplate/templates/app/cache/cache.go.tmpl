package appcache

import (
	"time"

	"github.com/asimmons91/trails/cache"
	"github.com/asimmons91/trails/cache/backend/memory"

	"{{.ModulePath}}/config"
)

// Configure builds the cache.Store for this app and the default TTL new
// entries should use. Only an in-process memory store is supported today;
// cfg.Cache.Store is read now so a future backend (file, redis, ...) can be
// selected the same way mailers.Configure picks a mail.Transport.
func Configure(cfg *config.Config) (cache.Store, time.Duration, error) {
	ttl, err := time.ParseDuration(cfg.Cache.TTL)
	if err != nil {
		return nil, 0, err
	}

	return memory.New(), ttl, nil
}
