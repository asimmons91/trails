package db

import (
	"fmt"

	"github.com/asimmons91/trails"
	"github.com/asimmons91/trails/pack"
	"github.com/asimmons91/trails/pack/driver/postgres"

	"{{.ModulePath}}/config"
)

func ConnectWithConfig(cfg *config.Config) (*pack.DB, error) {
	dsn := fmt.Sprintf(
		"host=%s port=%d user=%s password=%s dbname=%s sslmode=%s",
		cfg.Database.Host, cfg.Database.Port, cfg.Database.User, cfg.Database.Password, cfg.Database.Name, cfg.Database.SSLMode,
	)

	return pack.Connect(postgres.New(), dsn)
}

func Connect() (*pack.DB, error) {
	env := trails.Environment()
	cfg, err := trails.LoadConfig[config.Config](env, config.ConfigFS)
	if err != nil {
		return nil, err
	}

	return ConnectWithConfig(cfg)
}
