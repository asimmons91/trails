#!/usr/bin/env bash
#MISE description="Preview the full next release (version, tags, changelog) without making any changes"

set -e
ROOT=$(git rev-parse --show-toplevel)
source "${ROOT}/.mise/lib/release-common.sh"

next=$(compute_next_version)

echo "=== DRY RUN - nothing will be created or pushed ==="
echo "Next version: ${next}"
echo
echo "Tags that would be created:"
echo "  ${next}"
for m in "${SUBMODULES[@]}"; do
  echo "  ${m}/${next}"
done
echo

echo "go.mod requires that would be bumped to ${next}:"
for m in "${SUBMODULES[@]}"; do
  for dep in $(trails_requires_in "$m"); do
    echo "  ${m}/go.mod: ${dep} -> ${next}"
  done
done
echo
echo "--- Release notes preview ---"
render_notes "$next"
echo
echo "--- Release binaries preview (snapshot build, dist/ not published) ---"
goreleaser release --clean --skip=publish --skip=announce --snapshot
