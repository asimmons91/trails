#!/usr/bin/env bash
#MISE description="Cut a lockstep release: tag all modules, push, and create a GitHub Release"
#MISE depends=["check"]

set -e
ROOT=$(git rev-parse --show-toplevel)
source "${ROOT}/.mise/lib/release-common.sh"

if [ -n "$(git status --porcelain)" ]; then
  echo "ERROR: working tree is not clean. Commit or stash changes before releasing." >&2
  exit 1
fi

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" != "main" ]; then
  echo "WARN: releasing from branch '${branch}', not 'main'." >&2
fi

current=$(latest_root_tag)
next=$(compute_next_version)

if [ "$next" == "$current" ]; then
  echo "ERROR: no releasable changes since ${current}. Nothing to do." >&2
  exit 1
fi

echo "Releasing ${current:-<none>} -> ${next}"

notes_file=$(mktemp)
trap 'rm -f "$notes_file"' EXIT
render_notes "$next" > "$notes_file"

echo "Bumping go.mod requires to ${next}..."
bump_requires "$next"
if [ -n "$(git status --porcelain)" ]; then
  git add -- '**/go.mod'
  git commit -m "chore(release): bump go.mod requires to ${next}"
  git push origin "$branch"
fi

echo "Creating tags..."
git tag -a "$next" -m "Release ${next}"
for m in "${SUBMODULES[@]}"; do
  git tag -a "${m}/${next}" -m "Release ${m} ${next}"
done

# GORELEASER_CURRENT_TAG pins the version explicitly: HEAD carries both the
# root tag and every submodule's path-prefixed tag (e.g.
# jobs/backend/cloudtask/v0.1.1), so `git describe`'s own tag resolution
# is ambiguous and can pick a submodule tag instead of the root release tag.
echo "Building release binaries..."
GORELEASER_CURRENT_TAG="$next" goreleaser release --clean --skip=publish --skip=announce

echo "Pushing tags..."
git push origin "$next"
for m in "${SUBMODULES[@]}"; do
  git push origin "${m}/${next}"
done

echo "Creating GitHub Release..."
gh release create "$next" \
  --title "$next" \
  --notes-file "$notes_file" \
  dist/*.tar.gz dist/*.zip dist/checksums.txt

echo "Done. Released ${next}."
